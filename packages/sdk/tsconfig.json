{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "jsx": "react-jsx",
    "declaration": true,
    // TS 6.0 deprecates baseUrl (hard-removed in 7.0). The SDK tsconfig sets no baseUrl,
    // but tsup's declaration build (rollup-plugin-dts) injects one while resolving `paths`,
    // which trips TS5101. Acknowledge the 6.0 deprecation so the dts build succeeds; revisit
    // before TS 7.0.
    "ignoreDeprecations": "6.0",
    "paths": {
      "@sdk/*": ["./src/*"]
    }
  },
  "include": ["src", "test", "tsup.config.ts", "vitest.config.ts"],
  "exclude": ["node_modules", "dist"]
}
